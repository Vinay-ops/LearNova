# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/casepilot

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS / Frontend
FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI / LLM (Phase 6+ - optional)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=
