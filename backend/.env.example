# ===========================================
# LEARNOVA BACKEND — Environment Variables
# ===========================================

# Database — Supabase PostgreSQL
# Format: postgresql+psycopg://user:password@host:port/dbname?sslmode=require
# (plain postgresql:// URLs are also accepted — the app normalizes them to psycopg)
DATABASE_URL=postgresql+psycopg://user:password@host:port/dbname?sslmode=require

# JWT
JWT_SECRET=your-strong-random-secret-here

# CORS
FRONTEND_URL=http://localhost:5173

# AI provider: Groq (OpenAI-compatible API)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Default model: openai/gpt-oss-120b (verify availability via https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO