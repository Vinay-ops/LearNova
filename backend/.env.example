# ===========================================
# LEARNOVA BACKEND — Environment Variables
# ===========================================

# Database — Supabase PostgreSQL
# Format: postgresql+psycopg://user:password@host:port/dbname?sslmode=require
# (plain postgresql:// URLs are also accepted — the app normalizes them to psycopg)
DATABASE_URL=postgresql+psycopg://user:password@host:port/dbname?sslmode=require

# JWT
JWT_SECRET=your-strong-random-secret-here

# CORS
FRONTEND_URL=http://localhost:5173

# Explicit production CORS allowlist (comma-separated). Takes precedence over
# FRONTEND_URL. A wildcard "*" is stripped rather than honoured, because this
# API sends Access-Control-Allow-Credentials: true. REQUIRED in production.
# e.g. FRONTEND_ORIGINS=https://learnova.app,https://www.learnova.app
FRONTEND_ORIGINS=

# Origins allowed to embed the app in a frame. Leave EMPTY in production —
# empty means X-Frame-Options: DENY / frame-ancestors 'none'.
EMBED_ALLOWED_ORIGINS=

# AI provider: Groq (OpenAI-compatible API)
# Get a key at https://console.groq.com/keys
# The Groq base URL and model are code constants, not env vars:
# app/ai/client.py → GROQ_BASE_URL / GROQ_MODEL
GROQ_API_KEY=

# Environment
ENVIRONMENT=development

# Rate limiting. Enabled by default and must stay enabled in production.
# The limiter is per-process and in-memory: on a single instance it is real
# protection, but across N instances the effective limit is limit x N. See
# docs/SECURITY_LAUNCH_CHECKLIST.md before scaling out.
RATE_LIMIT_ENABLED=true

# Optional. When set, GET /api/health returns full infrastructure diagnostics
# (DB host/port, driver error text, config warnings) to a caller presenting this
# value in the X-Health-Token header. Without it, production returns the minimal
# probe only, so an anonymous caller cannot fingerprint the deployment.
HEALTH_DETAIL_TOKEN=