# ===========================================
# LEARNOVA — Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---- Frontend (Vite) ----
# Backend API URL (no trailing slash)
# Optional: when unset, the frontend calls the same origin (/api/*),
# which is how the Vercel services setup routes to the backend.
VITE_API_URL=http://localhost:8000

# ---- Backend (FastAPI) ----

# Database — Use Supabase PostgreSQL connection string
# Format: postgresql+psycopg://user:password@host:port/dbname?sslmode=require
# (plain postgresql:// URLs are also accepted — the app normalizes them to psycopg)
DATABASE_URL=

# JWT — Generate a strong random secret
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# CORS — Comma-separated allowed frontend origins
# For Vercel: https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=development

# ---- OpenRouter (AI) ----
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Learnova
OPENROUTER_SITE_URL=

# ---- OpenAI (legacy, optional) ----
# Only needed if using direct OpenAI API instead of OpenRouter
OPENAI_API_KEY=