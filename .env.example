# ===========================================
# LEARNOVA — Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---- Frontend (Vite) ----
#
# ⚠️  EVERY VITE_* VARIABLE IS PUBLIC. It is compiled into the JavaScript
#     bundle and readable by anyone who loads the app. Never put an API key,
#     database URL, JWT secret or any other credential here.

# Backend API URL (no trailing slash)
# Optional: when unset, the frontend calls the same origin (/api/*),
# which is how the Vercel services setup routes to the backend.
VITE_API_URL=http://localhost:8000

# Where the published Terms & Conditions / Privacy Policy live.
# Optional: when unset, the in-app /terms and /privacy routes are used, so the
# links always resolve. Set these to an absolute URL to host the legal documents
# on a separate marketing domain.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# ---- Backend (FastAPI) ----

# Database — Use Supabase PostgreSQL connection string
# Format: postgresql+psycopg://user:password@host:port/dbname?sslmode=require
# (plain postgresql:// URLs are also accepted — the app normalizes them to psycopg)
DATABASE_URL=

# JWT — Generate a strong random secret
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# CORS — Comma-separated allowed frontend origins
# For Vercel: https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173

# Explicit production CORS allowlist. Takes precedence over FRONTEND_URL.
# A wildcard "*" is rejected outright — this API accepts Authorization headers.
# REQUIRED in production.
FRONTEND_ORIGINS=

# Origins allowed to embed the app in an iframe. Leave EMPTY in production:
# empty means X-Frame-Options: DENY (clickjacking protection).
EMBED_ALLOWED_ORIGINS=

# Environment: development, staging, production
ENVIRONMENT=development

# ---- AI provider: Groq (OpenAI-compatible API) ----
# Get a key at https://console.groq.com/keys
# The Groq base URL and model are code constants, not env vars:
# backend/app/ai/client.py → GROQ_BASE_URL / GROQ_MODEL
GROQ_API_KEY=